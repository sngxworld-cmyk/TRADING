{
  "entities": {
    "users": {
      "title": "users",
      "description": "Registered client accounts and admin access status",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "username": { "type": "string" },
        "role": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastLogin": { "type": "string" },
        "hasSeenTutorial": { "type": "boolean" },
        "hasConfiguredJournal": { "type": "boolean" },
        "yearRange": { "type": "string" },
        "startMonth": { "type": "number" }
      },
      "required": ["email", "username", "role", "status"]
    },
    "preApprovedEmails": {
      "title": "preApprovedEmails",
      "description": "Pre-granted Gmail addresses by host admin",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "addedAt": { "type": "string" }
      },
      "required": ["email"]
    },
    "logs": {
      "title": "logs",
      "description": "Audit log stream for admin and user access events",
      "type": "object",
      "properties": {
        "timestamp": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string" }
      },
      "required": ["timestamp", "message"]
    },
    "authVerificationCodes": {
      "title": "authVerificationCodes",
      "description": "Authentication OTP verification codes",
      "type": "object",
      "properties": {
        "code": { "type": "string", "maxLength": 6 },
        "email": { "type": "string" },
        "expiresAt": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["code", "email", "expiresAt"]
    },
    "devices": {
      "title": "devices",
      "description": "Hardware device registrations for 1-device policy",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "registeredAt": { "type": "string" }
      },
      "required": ["email"]
    },
    "signals": {
      "title": "signals",
      "description": "Trading signals published in community groups",
      "type": "object",
      "properties": {
        "authorEmail": { "type": "string" },
        "market": { "type": "string" },
        "type": { "type": "string" },
        "entry": { "type": "string" },
        "stopLoss": { "type": "string" },
        "takeProfit": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["authorEmail", "market"]
    },
    "community_chats": {
      "title": "community_chats",
      "description": "Public chat messages and media",
      "type": "object",
      "properties": {
        "senderEmail": { "type": "string" },
        "senderName": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["senderEmail", "text"]
    }
  },
  "firestore": {
    "/users/{userEmail}": {
      "schema": "users",
      "description": "User profile, access status, and trading plan records"
    },
    "/preApprovedEmails/{userEmail}": {
      "schema": "preApprovedEmails",
      "description": "Pre-granted Gmail whitelist documents"
    },
    "/logs/{logId}": {
      "schema": "logs",
      "description": "Admin and security audit logs"
    },
    "/authVerificationCodes/{emailKey}": {
      "schema": "authVerificationCodes",
      "description": "Time-sensitive OTP verification codes"
    },
    "/devices/{deviceId}": {
      "schema": "devices",
      "description": "Registered user hardware device bindings"
    },
    "/signals/{signalId}": {
      "schema": "signals",
      "description": "Published community trading signals"
    },
    "/community_chats/{messageId}": {
      "schema": "community_chats",
      "description": "Community hub live chat messages"
    }
  }
}
