{
  "entities": {
    "users": {
      "title": "users",
      "description": "Registered client accounts and admin access status",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "username": { "type": "string" },
        "role": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastLogin": { "type": "string" },
        "yearRange": { "type": "string" },
        "startMonth": { "type": "number" }
      },
      "required": ["email", "username", "role", "status"]
    },
    "preApprovedEmails": {
      "title": "preApprovedEmails",
      "description": "Pre-granted Gmail addresses by host admin",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "addedAt": { "type": "string" }
      },
      "required": ["email"]
    },
    "logs": {
      "title": "logs",
      "description": "Audit log stream for admin and user access events",
      "type": "object",
      "properties": {
        "timestamp": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string" }
      },
      "required": ["timestamp", "message"]
    }
  },
  "firestore": {
    "/users/{userEmail}": {
      "schema": "users",
      "description": "User profile, credentials, access status, and trading plan records"
    },
    "/preApprovedEmails/{userEmail}": {
      "schema": "preApprovedEmails",
      "description": "Pre-granted Gmail whitelist documents"
    },
    "/logs/{logId}": {
      "schema": "logs",
      "description": "Admin and security audit logs"
    }
  }
}
