rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User-specific private trading journals, settings, and profile data
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId 
                   || request.resource.data.email == request.auth.token.email
                   || resource == null;
    }
    
    // Authentication OTP verification codes (auto-expires in 10 mins)
    match /authVerificationCodes/{emailKey} {
      allow read, write: if true;
    }

    // Community Live Signals
    match /signals/{signalId} {
      allow read: if true;
      allow create: if request.auth != null || request.resource.data.authorEmail != null;
      allow update, delete: if request.auth != null || resource.data.authorEmail == request.resource.data.authorEmail;
    }
    
    // Community Signal Groups
    match /signal_groups/{groupId} {
      allow read: if true;
      allow write: if request.auth != null || request.resource.data.createdBy != null;
    }

    // Community Chat & Discussion Boards
    match /community_chats/{messageId} {
      allow read: if true;
      allow create: if request.resource.data.senderEmail != null;
      allow update, delete: if request.auth != null;
    }
    
    // Fallback: Deny unhandled arbitrary root access
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
