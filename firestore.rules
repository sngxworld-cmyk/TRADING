rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User-specific trading journals, settings, and profile data
    // read (get & list) permitted so Host Admin dashboard can list all clients and inspect profiles
    match /users/{userId} {
      allow read: if true;
      allow create: if request.resource.data.email is string;
      allow update: if true;
      allow delete: if true;
    }
    
    // Authentication OTP verification codes (auto-expires in 10 mins)
    // NEVER allow list queries to prevent hackers dumping all active OTPs with automated tools
    match /authVerificationCodes/{emailKey} {
      allow get: if true;
      allow list: if false; // STRICT BLOCK: Automated scanners cannot enumerate or dump all active OTPs
      allow create, update: if request.resource.data.code is string && request.resource.data.code.size() == 6;
      allow delete: if true;
    }

    // Ban Appeals submitted by banned users - Host Admin reviews and approves/rejects
    match /banAppeals/{emailKey} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Pre-approved whitelist emails - Host Admin manages whitelist
    match /preApprovedEmails/{emailKey} {
      allow read, write: if true;
    }

    // Registered hardware devices - Host Admin inspects linked hardware devices
    match /devices/{deviceId} {
      allow read, write: if true;
    }

    // System audit logs - Tamper-proof append-only ledger
    match /system_audit_logs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false; // Attackers cannot tamper with or delete audit logs
    }

    match /logs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false; // Attackers cannot tamper with or delete audit logs
    }

    // Community Live Signals
    match /signals/{signalId} {
      allow read, write: if true;
    }
    
    // Community Signal Groups
    match /signal_groups/{groupId} {
      allow read, write: if true;
    }

    // Community Chat & Discussion Boards
    match /community_chats/{messageId} {
      allow read, write: if true;
    }

    // Direct Messages
    match /direct_messages/{messageId} {
      allow read, write: if true;
    }

    // Default Deny: Block any unauthorized or unmapped paths to prevent arbitrary collection creation or enumeration
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

